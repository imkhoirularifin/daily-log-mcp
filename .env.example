# Required. Comma-separated Bearer tokens (one per AI client is fine).
MCP_API_KEY=change-me-claude-key,change-me-cursor-key

# Optional. SQLite file path (default /data/daily-log.db).
DATABASE_PATH=./data/daily-log.db

# Optional. HTTP listen port (default 3000).
PORT=3000

# Optional. Bind address (default 0.0.0.0 for Docker).
HOST=0.0.0.0
