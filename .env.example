# --- Auth bootstrap (pick one approach) ---
#
# Preferred (matches ops key names). Values are the raw Bearer tokens already
# in use. On startup they are hashed into api_keys and linked to users
# (idempotent). Never commit real values.
DAILY_LOG_MCP_KEY_ARIFIN=change-me-arifin-key
DAILY_LOG_MCP_KEY_DORI=change-me-dori-key
DAILY_LOG_MCP_KEY_DOCUMIND_DEVOPS=change-me-devops-key

# Optional generic bootstrap (comma-separated). Format per entry:
#   <key>|<nama>|<role>|<admin>
# admin = 1|0|true|false|admin|user
# MCP_BOOTSTRAP_KEYS=sk-alza|Alza|Frontend|0

# Legacy: comma-separated keys. Only used when the DB has no active keys and
# none of the named / MCP_BOOTSTRAP_KEYS entries above are set. All keys map to
# Arifin/Backend (non-admin) — prefer named keys so Dori is admin.
# MCP_API_KEY=change-me-claude-key,change-me-cursor-key

# Optional. SQLite file path (default /data/daily-log.db).
DATABASE_PATH=./data/daily-log.db

# Optional. HTTP listen port (default 3000).
PORT=3000

# Optional. Bind address (default 0.0.0.0 for Docker).
HOST=0.0.0.0
