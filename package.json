{
  "name": "daily-log-mcp",
  "version": "1.2.0",
  "description": "MCP server for recording daily work tasks into a central inbox (SQLite), then syncing to Google Sheets",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "daily-log-mcp": "./dist/index.js",
    "daily-log-cli": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
